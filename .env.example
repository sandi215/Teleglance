# TeleGlance backend config — copy to server/.env, never commit .env
PORT=3000
# Telegram bot token from @BotFather (backend only, never in the app).
# If unset, the backend uses the custom.telegram connector helper.
TELEGRAM_BOT_TOKEN=
# Optional override for the connector helper path.
# TELEGRAM_HELPER=/home/hatch/workspace/custom-connectors/custom.telegram/bin/telegram.py
# Optional: Xingchi LLM key for AI digests/drafts (extractive fallback if unset)
XINGCHI_API_KEY=
# Demo mode: 1 = scripted demo data + scripted transcripts (simulator has no live mic)
DEMO_MODE=1
